# Salin file ini menjadi .env.local lalu isi dengan nilai Anda sendiri.
# JANGAN commit file .env.local ke Git (sudah otomatis diabaikan lewat .gitignore).

# Database Turso (WAJIB diisi untuk production/online, tidak wajib untuk development lokal)
TURSO_DATABASE_URL=libsql://nama-database-anda.turso.io
TURSO_AUTH_TOKEN=isi_dengan_token_dari_dashboard_turso

# Password untuk login ke halaman /admin
ADMIN_PASSWORD=ganti_dengan_password_rahasia_anda

# Teks acak panjang untuk menandatangani sesi login admin (boleh string apa saja, semakin panjang semakin aman)
ADMIN_SESSION_SECRET=ganti_dengan_teks_acak_yang_panjang_dan_rahasia
